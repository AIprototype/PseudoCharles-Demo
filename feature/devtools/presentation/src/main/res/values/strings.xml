    <!-- Live feed status -->
    <string name="live_feed_status_disconnected">Disconnected</string>
    <string name="live_feed_status_connecting">Connecting…</string>
    <string name="live_feed_status_connected">Connected</string>
    <string name="live_feed_status_unreachable_title">Echo server unreachable</string>
    <string name="live_feed_status_unreachable_body">echo.websocket.org did not answer. This is a third-party outage, not a problem with socket inspection — HTTP capture and every other tab are unaffected.</string>
    <string name="live_feed_status_no_network_title">Device is offline</string>
    <string name="live_feed_status_no_network_body">This device has no internet connection. Turn off airplane mode or reconnect to Wi-Fi, then retry.</string>
    <string name="live_feed_status_rejected_title">Handshake refused (HTTP %1$d)</string>
    <string name="live_feed_status_rejected_body">The echo server refused the WebSocket upgrade. Again, third-party — not the SDK.</string>
    <string name="live_feed_status_closed_title">Server closed the connection</string>
    <string name="live_feed_status_closed_body">Closed with code %1$d: %2$s</string>
    <string name="live_feed_status_unknown_title">Connection failed</string>
    <string name="live_feed_status_unknown_body">Unexpected failure talking to echo.websocket.org: %1$s. Socket capture itself is unaffected — check the Sockets tab, the frames sent before this point are still there.</string>

