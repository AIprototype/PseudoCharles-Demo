    <!-- Live feed -->
    <string name="live_feed_title">Taproom Live</string>
    <string name="live_feed_disclaimer">Simulated feed. Open Brewery DB has no realtime API, so this app sends Socket.IO-shaped events to a public echo server, which bounces them straight back. The round trip is the point: the echoed copies arrive as inbound frames with a decodable event name.</string>
    <string name="live_feed_endpoint">Endpoint: %1$s</string>
    <string name="live_feed_connect">Connect</string>
    <string name="live_feed_disconnect">Disconnect</string>
    <string name="live_feed_retry">Retry</string>
    <string name="live_feed_auto_emit">Emit a check-in every 2.5s</string>
    <string name="live_feed_send_checkin">Check-in event</string>
    <string name="live_feed_send_text">Plain text</string>
    <string name="live_feed_send_binary">Binary</string>
    <string name="live_feed_clear">Clear</string>
    <string name="live_feed_open_inspector">Open Sockets inspector</string>
    <string name="live_feed_empty">No frames yet. Connect, then send a check-in.</string>
